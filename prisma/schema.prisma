generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  MISC
}

enum GramaticalGender {
  MASCULINO
  FEMININO
}

model Users {
  id         String       @id @db.Uuid
  email      String       @unique
  name       String?
  avatarUrl  String?
  characters Characters[]

  @@map("users")
}

model Characters {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                @unique
  race_id              String                @db.Uuid
  race                 Races                 @relation(fields: [race_id], references: [id])
  class_id             String                @db.Uuid
  class                Classes               @relation(fields: [class_id], references: [id])
  user_id              String                @db.Uuid
  user                 Users                 @relation(fields: [user_id], references: [id])
  level                Int                   @default(1)
  max_hp               Int
  current_hp           Int
  gramaticalGender     GramaticalGender
  character_attributes CharacterAttributes[]
  character_items      CharacterItems[]
  character_skills     CharacterSkills[]

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("characters")
}

model Classes {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String       @unique @db.VarChar
  hit_die              Int
  description          String
  base_attributes      String
  base_attributes_code String[]
  pericias             String
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  characters           Characters[]

  @@map("classes")
}

model Races {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique @db.VarChar
  description    String
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  characters     Characters[]
  races_modifier RacesModifier[]

  @@map("races")
}

model RacesModifier {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  race_id   String @db.Uuid
  race      Races  @relation(fields: [race_id], references: [id])
  attribute String
  value     Int

  @@map("races_modifier")
}

model Attributes {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                @unique @db.VarChar
  code                 String                @unique @db.VarChar
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  character_attributes CharacterAttributes[]
  skills               Skills[]

  @@map("attributes")
}

model CharacterAttributes {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id String     @db.Uuid
  character    Characters @relation(fields: [character_id], references: [id], map: "fk_character_attributes_character", onDelete: Cascade)
  attribute_id String     @db.Uuid
  attribute    Attributes @relation(fields: [attribute_id], references: [id], map: "fk_character_attributes_attribute")
  base_value   Int
  modifier     Int

  @@unique([character_id, attribute_id])
  @@map("character_attributes")
}

model Items {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar
  type            ItemType
  weight          Float?
  description     String?
  armor           Armors?
  weapon          Weapons?
  image_url       String?
  character_items CharacterItems[]
  created_at      DateTime         @default(now()) @db.Timestamptz(6)

  @@map("items")
}

model Armors {
  item_id          String @id @db.Uuid
  item             Items  @relation(fields: [item_id], references: [id], onDelete: Cascade)
  base_armor_class Int
  max_dex_bonus    Int? // NULL = sem limite

  @@map("armors")
}

model Weapons {
  item_id     String  @id @db.Uuid
  item        Items   @relation(fields: [item_id], references: [id], onDelete: Cascade)
  damage_dice String // ex: "1d8"
  damage_type String // slashing, piercing, bludgeoning
  range       Int?
  properties  String? // finesse, light, two-handed etc

  @@map("weapons")
}

model CharacterItems {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id String     @db.Uuid
  character    Characters @relation(fields: [character_id], references: [id], onDelete: Cascade)
  item_id      String     @db.Uuid
  item         Items      @relation(fields: [item_id], references: [id])
  quantity     Int
  equipped     Boolean
  slot         String

  @@map("character_items")
}

model Skills {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @unique
  attribute_id String     @db.Uuid
  attribute    Attributes @relation(fields: [attribute_id], references: [id])

  character_skills CharacterSkills[]

  @@map("skills")
}

model CharacterSkills {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id String     @db.Uuid
  character    Characters @relation(fields: [character_id], references: [id], onDelete: Cascade)
  skill_id     String     @db.Uuid
  skill        Skills     @relation(fields: [skill_id], references: [id])

  @@unique([character_id, skill_id])
  @@map("character_skills")
}
