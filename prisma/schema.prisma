generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Characters {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique
  race_id             String                @db.Uuid
  race                Races                 @relation(fields: [race_id], references: [id])
  class_id            String                @db.Uuid
  class               Classes               @relation(fields: [class_id], references: [id])
  level               Int                   @default(1)
  max_hp              Int
  current_hp          Int
  characterAttributes CharacterAttributes[]

  @@map("characters")
}

model Classes {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique @db.VarChar
  hit_die     Int
  description String
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  characters  Characters[]

  @@map("classes")
}

model Races {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique @db.VarChar
  description String
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  characters  Characters[]

  @@map("races")
}

model Attributes {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar
  code                String                @unique @db.VarChar
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  characterAttributes CharacterAttributes[]

  @@map("attributes")
}

model CharacterAttributes {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id String     @db.Uuid
  character    Characters @relation(fields: [character_id], references: [id], map: "fk_character_attributes_character")
  attribute_id String     @db.Uuid
  attribute    Attributes @relation(fields: [attribute_id], references: [id], map: "fk_character_attributes_attribute")
  base_value   Int

  @@unique([character_id, attribute_id])
  @@map("character_attributes")
}

model Skills {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  related_attribute String

  @@map("skills")
}
